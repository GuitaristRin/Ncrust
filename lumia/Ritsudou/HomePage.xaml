<Page
    x:Class="Ritsudou.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource RitsudouBackgroundBrush}"
    Loaded="OnLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,20,16,12">
            <TextBlock Text="推荐歌单" Style="{StaticResource RitsudouHeaderText}"/>
        </Grid>

        <Grid Grid.Row="1">
            <GridView x:Name="PlaylistGrid"
                      Style="{StaticResource RitsudouGrid}"
                      ItemContainerStyle="{StaticResource RitsudouGridItem}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      Padding="12,0"/>
            <ProgressRing x:Name="LoadingRing"
                          Style="{StaticResource RitsudouLoadingRing}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsActive="True"/>
            <TextBlock x:Name="ErrorText"
                       Style="{StaticResource RitsudouSubtitleText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>
