<Page
    x:Class="Ritsudou.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource RitsudouBackgroundBrush}"
    Loaded="OnLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：Metro 页眉，小号大字距大写 -->
        <Grid Grid.Row="0" Padding="16,20,16,4">
            <TextBlock Text="律動" Style="{StaticResource RitsudouHeaderText}"/>
        </Grid>

        <!-- 搜索框：无边框 + 2px 强调色下划线 -->
        <Grid Grid.Row="1" Margin="16,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="SearchBox"
                     Grid.Row="0"
                     Style="{StaticResource RitsudouSearchBox}"
                     PlaceholderText="搜索歌曲 / 专辑 / 艺人"
                     TextChanged="OnSearchTextChanged"/>
            <Rectangle Grid.Row="1" Fill="{StaticResource RitsudouAccentBrush}" Height="2"/>
        </Grid>

        <!-- 搜索分类：歌曲 / 专辑 / 艺人 -->
        <Grid Grid.Row="2" Margin="16,0,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <RadioButton x:Name="SongTab"
                         Grid.Column="0"
                         GroupName="SearchTab"
                         Content="歌曲"
                         IsChecked="True"
                         Style="{StaticResource RitsudouTabRadio}"
                         Checked="OnTabChanged"/>
            <RadioButton x:Name="AlbumTab"
                         Grid.Column="1"
                         GroupName="SearchTab"
                         Content="专辑"
                         Style="{StaticResource RitsudouTabRadio}"
                         Checked="OnTabChanged"/>
            <RadioButton x:Name="ArtistTab"
                         Grid.Column="2"
                         GroupName="SearchTab"
                         Content="艺人"
                         Style="{StaticResource RitsudouTabRadio}"
                         Checked="OnTabChanged"/>
        </Grid>

        <!-- 结果列表 -->
        <Grid Grid.Row="3">
            <ListView x:Name="ResultList"
                      Style="{StaticResource RitsudouList}"
                      ItemContainerStyle="{StaticResource RitsudouListItem}"
                      SelectionMode="None"/>
            <TextBlock x:Name="EmptyHint"
                       Text="输入关键词，搜索网易云音乐"
                       Style="{StaticResource RitsudouSubtitleText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>

        <!-- 播放条 -->
        <Grid x:Name="PlayerBar"
              Grid.Row="4"
              Background="{StaticResource RitsudouSurfaceBrush}"
              Visibility="Collapsed"
              Tapped="OnPlayerBarTapped">
            <Grid.RowDefinitions>
                <RowDefinition Height="2"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ProgressBar x:Name="PlayerProgress"
                         Grid.Row="0"
                         Style="{StaticResource RitsudouProgressBar}"
                         IsIndeterminate="False"/>
            <Grid Grid.Row="1" Height="64" Padding="8,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="PlayerCover"
                       Grid.Column="0"
                       Width="48" Height="48"
                       Stretch="UniformToFill"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                    <TextBlock x:Name="PlayerTitle" Style="{StaticResource RitsudouTitleText}"/>
                    <TextBlock x:Name="PlayerSubtitle" Style="{StaticResource RitsudouSubtitleText}"/>
                </StackPanel>
                <Button x:Name="NextButton"
                        Grid.Column="2"
                        Style="{StaticResource RitsudouIconButton}"
                        Padding="8,8"
                        Click="OnNextClick">
                    <FontIcon Glyph="&#xE101;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
                </Button>
                <Button x:Name="PlayPauseButton"
                        Grid.Column="3"
                        Style="{StaticResource RitsudouIconButton}"
                        Padding="16,8"
                        Click="OnPlayPauseClick">
                    <FontIcon Glyph="&#xE102;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
