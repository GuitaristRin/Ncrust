<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Ritsudou Metro 色板（与 Android 版 RitsudouColors 一致） ============ -->
    <Color x:Key="RitsudouBackgroundColor">#FF000000</Color>
    <Color x:Key="RitsudouSurfaceColor">#FF1A1A1A</Color>
    <Color x:Key="RitsudouAccentColor">#FF1DB954</Color>
    <Color x:Key="RitsudouTextColor">#FFFFFFFF</Color>
    <Color x:Key="RitsudouMutedTextColor">#FFB3B3B3</Color>
    <Color x:Key="RitsudouDividerColor">#FF2A2A2A</Color>

    <SolidColorBrush x:Key="RitsudouBackgroundBrush" Color="{StaticResource RitsudouBackgroundColor}" />
    <SolidColorBrush x:Key="RitsudouSurfaceBrush" Color="{StaticResource RitsudouSurfaceColor}" />
    <SolidColorBrush x:Key="RitsudouAccentBrush" Color="{StaticResource RitsudouAccentColor}" />
    <SolidColorBrush x:Key="RitsudouTextBrush" Color="{StaticResource RitsudouTextColor}" />
    <SolidColorBrush x:Key="RitsudouMutedTextBrush" Color="{StaticResource RitsudouMutedTextColor}" />
    <SolidColorBrush x:Key="RitsudouDividerBrush" Color="{StaticResource RitsudouDividerColor}" />

    <FontFamily x:Key="RitsudouFontFamily">Segoe WP</FontFamily>

    <!-- ============ 文本层级 ============ -->
    <Style x:Key="RitsudouHeaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RitsudouFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="200" />
        <Setter Property="Foreground" Value="{StaticResource RitsudouMutedTextBrush}" />
    </Style>

    <Style x:Key="RitsudouPageTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RitsudouFontFamily}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{StaticResource RitsudouTextBrush}" />
    </Style>

    <Style x:Key="RitsudouTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RitsudouFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource RitsudouTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="RitsudouSubtitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RitsudouFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource RitsudouMutedTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ============ 控件：直角 / 无圆角 / 信息优先 ============ -->
    <Style x:Key="RitsudouSearchBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource RitsudouTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource RitsudouFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="16,0,16,0" />
        <Setter Property="SelectionHighlightColor" Value="{StaticResource RitsudouAccentBrush}" />
        <Setter Property="IsSpellCheckEnabled" Value="False" />
    </Style>

    <Style x:Key="RitsudouList" TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="IsItemClickEnabled" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="RitsudouGrid" TargetType="GridView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="IsItemClickEnabled" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
    </Style>

    <Style x:Key="RitsudouListItem" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource RitsudouTextBrush}" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="SelectedForeground" Value="{StaticResource RitsudouTextBrush}" />
    </Style>

    <Style x:Key="RitsudouGridItem" TargetType="GridViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style x:Key="RitsudouIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource RitsudouTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource RitsudouFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="RitsudouBottomSheet" TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource RitsudouSurfaceBrush}" />
    </Style>

    <Style x:Key="RitsudouPlayAllButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource RitsudouAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#FF000000" />
        <Setter Property="FontFamily" Value="{StaticResource RitsudouFontFamily}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="RitsudouTabRadio" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource RitsudouMutedTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource RitsudouFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="RitsudouNavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource RitsudouMutedTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource RitsudouFontFamily}" />
        <Setter Property="Padding" Value="0,6,0,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="RitsudouProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="2" />
        <Setter Property="Foreground" Value="{StaticResource RitsudouAccentBrush}" />
        <Setter Property="Background" Value="{StaticResource RitsudouDividerBrush}" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
    </Style>

    <Style x:Key="RitsudouLoadingRing" TargetType="ProgressRing">
        <Setter Property="Foreground" Value="{StaticResource RitsudouAccentBrush}" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>

</ResourceDictionary>
