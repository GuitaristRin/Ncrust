<Page
    x:Class="Ritsudou.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource RitsudouBackgroundBrush}"
    Loaded="OnLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,20,16,12">
            <TextBlock Text="我喜欢的音乐" Style="{StaticResource RitsudouHeaderText}"/>
        </Grid>

        <Grid Grid.Row="1">
            <ListView x:Name="SongList"
                      Style="{StaticResource RitsudouList}"
                      ItemContainerStyle="{StaticResource RitsudouListItem}"
                      SelectionMode="None"/>
            <TextBlock x:Name="EmptyHint"
                       Text="还没有收藏的歌曲"
                       Style="{StaticResource RitsudouSubtitleText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Page>
