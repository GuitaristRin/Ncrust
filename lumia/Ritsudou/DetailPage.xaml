<Page
    x:Class="Ritsudou.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource RitsudouBackgroundBrush}"
    Loaded="OnLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：返回 + 标题 -->
        <Grid Grid.Row="0" Padding="8,12,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource RitsudouIconButton}"
                    Click="OnBackClick">
                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
            </Button>
            <TextBlock Grid.Column="1"
                       x:Name="PageTitle"
                       Text="详情"
                       Style="{StaticResource RitsudouHeaderText}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- 头部：封面 + 标题 + 副标题 + 播放全部 -->
        <Grid Grid.Row="1" Margin="16,4,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="128" Height="128">
                <Image x:Name="CoverImage"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4">
                <TextBlock x:Name="TitleText"
                           Style="{StaticResource RitsudouPageTitleText}"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="SubtitleText"
                           Style="{StaticResource RitsudouSubtitleText}"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="DescText"
                           Style="{StaticResource RitsudouSubtitleText}"
                           MaxLines="3"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
                <Button x:Name="PlayAllButton"
                        Margin="0,8,0,0"
                        Style="{StaticResource RitsudouPlayAllButton}"
                        Click="OnPlayAllClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                        <TextBlock Text="播放全部" FontSize="14"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 歌曲列表 -->
        <Grid Grid.Row="2">
            <ListView x:Name="SongList"
                      Style="{StaticResource RitsudouList}"
                      ItemContainerStyle="{StaticResource RitsudouListItem}"
                      SelectionMode="None"/>
            <ProgressRing x:Name="LoadingRing"
                          Style="{StaticResource RitsudouLoadingRing}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsActive="True"/>
            <TextBlock x:Name="ErrorText"
                       Style="{StaticResource RitsudouSubtitleText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>
