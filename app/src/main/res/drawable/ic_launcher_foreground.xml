<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon 前景层。
  与 About 页共用的 @drawable/ic_launcher 不同：那份是 192 满幅内容，
  直接塞进 108 的 adaptive 层后 record 直径 ~79 > mask 可见区 ~72，白圈会被切。
  这里把内容按 0.75 缩放（绿色圆仍大于 mask，保证铺满无缝隙），
  record 缩到可见区的 ~75%，与 About 页观感一致。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="192"
    android:viewportHeight="192">

    <group
        android:pivotX="96"
        android:pivotY="96"
        android:scaleX="0.75"
        android:scaleY="0.75">

        <!-- 绿色圆形背景 -->
        <path
            android:fillColor="#1DB954"
            android:pathData="M96,96m-96,0a96,96 0,1 1,192 0a96,96 0,1 1,-192 0" />

        <!-- 唱片外圈 -->
        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="12"
            android:pathData="M96,96m-64,0a64,64 0,1 1,128 0a64,64 0,1 1,-128 0" />

        <!-- 唱片内圈 -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M96,96m-20,0a20,20 0,1 1,40 0a20,20 0,1 1,-40 0" />

        <!-- 唱片中心孔 -->
        <path
            android:fillColor="#1DB954"
            android:pathData="M96,96m-8,0a8,8 0,1 1,16 0a8,8 0,1 1,-16 0" />

        <!-- 播放缺口 -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M144,96 L128,80 L128,112 Z" />
    </group>
</vector>
