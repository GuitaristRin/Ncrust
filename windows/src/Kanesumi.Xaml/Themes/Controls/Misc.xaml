<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 分隔线：1px、divider 色，只做水平方向。 -->
    <Style x:Key="MetroDividerStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Fill" Value="{ThemeResource KDividerBrush}" />
    </Style>

    <!--
      列表行：左 0 右 16、上下 8 由行内容自己控制；这里只去掉 ListViewItem 的默认内边距与最小高度，
      并让内容横向拉伸。圆角由 Overrides.xaml 的 CornerRadius 归零覆盖。
    -->
    <Style x:Key="MetroListRowStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
      网格磁贴容器：横向 20、纵向 28，去掉 GridViewItem 默认的外边距与内边距。
      桌面有意偏离 tokens.json 的 layout.gridSpacing = 2（Android 手机上 spacedBy(2.dp) 的拼贴感）：
      桌面窗口里一整面墙挤在 2 的缝里显得太紧张（负责人反馈，2026-09-27），改为 Apple Music 式的留白。
    -->
    <Style x:Key="MetroGridTileStyle" TargetType="GridViewItem">
        <Setter Property="Margin" Value="0,0,20,28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <!-- 文本框 / 搜索框：surfaceVariant 底、内边距 12、无边框、无圆角（平台默认模板绑定这些属性）。 -->
    <Style x:Key="MetroTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource KSurfaceVariantBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource KOnSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!--
      歌词行颜色（MetroLyricsPanel 按行状态切换样式）：当前行 primary；已唱行 onBackground、
      未唱行 onSurfaceVariant（透明度 0.6 / 0.4 由面板设置）。用 ThemeResource，明暗主题下都可读 ——
      sec-a 默认写死白色，浅色底上看不见（Ncrust LyricsView 同样改用了语义色）。
    -->
    <Style x:Key="MetroLyricCurrentTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource KPrimaryBrush}" />
    </Style>
    <Style x:Key="MetroLyricPastTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource KOnBackgroundBrush}" />
    </Style>
    <Style x:Key="MetroLyricFutureTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource KOnSurfaceVariantBrush}" />
    </Style>

</ResourceDictionary>
