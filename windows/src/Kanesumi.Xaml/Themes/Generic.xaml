<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kanesumi.Xaml.Controls">

    <!--
      自定义控件（MetroProgressRing 等）的默认样式。框架按 DefaultStyleKey 从这里加载，
      文件名和位置不能改。
    -->

    <Style TargetType="local:MetroProgressRing">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MetroProgressRing">
                    <Grid Width="36" Height="36">
                        <!-- 270° 弧：顶部起点，顺时针到左侧；圆头端帽，与 sec-a 一致。 -->
                        <Path
                            x:Name="ArcPath"
                            Data="M 18,1.5 A 16.5,16.5 0 1 1 1.5,18"
                            Stroke="{ThemeResource KPrimaryBrush}"
                            StrokeThickness="3"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
