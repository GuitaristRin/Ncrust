<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      颜色 token。取值与 spec/design/tokens.json 的 color.dark / color.light 一一对应，
      改值先改 tokens.json。全部不透明（PressTint 除外），不引用任何系统画刷 ——
      系统半透明色压在材质混合出来的中灰底上会看不见（arc-deck 实测）。

      明暗由根元素的 RequestedTheme 切换；强调色见下方 KPrimaryBrush。
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="KBackgroundColor">#FF000000</Color>
            <Color x:Key="KSurfaceColor">#FF1A1A1A</Color>
            <Color x:Key="KSurfaceVariantColor">#FF1A1A1A</Color>
            <Color x:Key="KOnBackgroundColor">#FFFFFFFF</Color>
            <Color x:Key="KOnSurfaceColor">#FFFFFFFF</Color>
            <Color x:Key="KOnSurfaceVariantColor">#FFB3B3B3</Color>
            <Color x:Key="KDividerColor">#FF2A2A2A</Color>
            <Color x:Key="KPressTintColor">#22FFFFFF</Color>

            <SolidColorBrush x:Key="KBackgroundBrush" Color="{StaticResource KBackgroundColor}" />
            <SolidColorBrush x:Key="KSurfaceBrush" Color="{StaticResource KSurfaceColor}" />
            <SolidColorBrush x:Key="KSurfaceVariantBrush" Color="{StaticResource KSurfaceVariantColor}" />
            <SolidColorBrush x:Key="KOnBackgroundBrush" Color="{StaticResource KOnBackgroundColor}" />
            <SolidColorBrush x:Key="KOnSurfaceBrush" Color="{StaticResource KOnSurfaceColor}" />
            <SolidColorBrush x:Key="KOnSurfaceVariantBrush" Color="{StaticResource KOnSurfaceVariantColor}" />
            <SolidColorBrush x:Key="KDividerBrush" Color="{StaticResource KDividerColor}" />
            <SolidColorBrush x:Key="KPressTintBrush" Color="{StaticResource KPressTintColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="KBackgroundColor">#FFF6F2E9</Color>
            <Color x:Key="KSurfaceColor">#FFFFFDF8</Color>
            <Color x:Key="KSurfaceVariantColor">#FFEDE6D8</Color>
            <Color x:Key="KOnBackgroundColor">#FF1C1A16</Color>
            <Color x:Key="KOnSurfaceColor">#FF1C1A16</Color>
            <Color x:Key="KOnSurfaceVariantColor">#FF6E6658</Color>
            <Color x:Key="KDividerColor">#FFE2DACB</Color>
            <Color x:Key="KPressTintColor">#14000000</Color>

            <SolidColorBrush x:Key="KBackgroundBrush" Color="{StaticResource KBackgroundColor}" />
            <SolidColorBrush x:Key="KSurfaceBrush" Color="{StaticResource KSurfaceColor}" />
            <SolidColorBrush x:Key="KSurfaceVariantBrush" Color="{StaticResource KSurfaceVariantColor}" />
            <SolidColorBrush x:Key="KOnBackgroundBrush" Color="{StaticResource KOnBackgroundColor}" />
            <SolidColorBrush x:Key="KOnSurfaceBrush" Color="{StaticResource KOnSurfaceColor}" />
            <SolidColorBrush x:Key="KOnSurfaceVariantBrush" Color="{StaticResource KOnSurfaceVariantColor}" />
            <SolidColorBrush x:Key="KDividerBrush" Color="{StaticResource KDividerColor}" />
            <SolidColorBrush x:Key="KPressTintBrush" Color="{StaticResource KPressTintColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--
      强调色不随明暗变化，是单一共享的画刷实例：KanesumiAccent.FollowSystem 在启动时把它改成
      Windows 的系统强调色，并在用户改色时实时跟随；所有引用处即时更新，不用重载资源。
      这里写的云杉 #1DB954 只是读不到系统强调色时的内置兜底（tokens.json accents.default = 0）。
      onPrimary 按强调色亮度在黑 / 白之间选（浅色强调色上白字看不清）。
    -->
    <SolidColorBrush x:Key="KPrimaryBrush" Color="#FF1DB954" />
    <SolidColorBrush x:Key="KOnPrimaryBrush" Color="#FFFFFFFF" />

</ResourceDictionary>
