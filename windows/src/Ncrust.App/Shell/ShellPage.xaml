<Page
    x:Class="Ncrust.Shell.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="{ThemeResource KBackgroundBrush}">

    <!--
      外壳：标题栏 + 侧栏（MetroSidebarStyle）+ 内容 Frame + 覆盖层。
      窄窗口的 MetroBottomNav 与播放栏/播放器层后续加入。背景显式使用 token 的 background。
    -->
    <Grid Background="{ThemeResource KBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="16,0"
            VerticalAlignment="Center"
            FontSize="13"
            Foreground="{ThemeResource KOnBackgroundBrush}"
            Text="Ncrust" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="Sidebar"
                Grid.Column="0"
                SelectionChanged="SidebarSelectionChanged"
                Style="{StaticResource MetroSidebarStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Frame x:Name="ContentFrame" Grid.Column="1" />
        </Grid>

        <Grid x:Name="OverlayHost" Grid.RowSpan="2" />
    </Grid>
</Page>
