<Page
    x:Class="Ncrust.Shell.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="{ThemeResource KBackgroundBrush}">

    <!--
      外壳占位。按 windows/AGENTS.md「UI 与交互」，这里将是：
      MetroSidebar（宽窗口）/ MetroBottomNav（窄窗口）+ 内容 Frame + 播放栏 + 全屏播放器层。
      OverlayHost 承载登录层等临时覆盖层。背景显式使用 KBackgroundBrush，不依赖系统材质。
      本阶段的按钮/文案只是 M0 播放验证入口。
    -->
    <Grid>
        <Grid Padding="24,32,24,0">
            <StackPanel Spacing="16" VerticalAlignment="Top">
                <TextBlock Text="Ncrust" Style="{StaticResource PageHeadingTextStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="LoginButton" Content="登录" Click="LoginClick" />
                    <Button x:Name="PlayTestButton" Content="播放测试曲" Click="PlayTestClick" />
                    <Button x:Name="PlayPauseButton" Content="播放 / 暂停" Click="PlayPauseClick" />
                    <Button x:Name="NextButton" Content="下一首" Click="NextClick" />
                </StackPanel>
                <TextBlock x:Name="CurrentText" Style="{StaticResource CaptionTextStyle}" Text="未播放" />
            </StackPanel>
        </Grid>

        <Grid x:Name="OverlayHost" />
    </Grid>
</Page>
