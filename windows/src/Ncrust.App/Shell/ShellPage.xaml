<Page
    x:Class="Ncrust.Shell.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:player="using:Ncrust.Player"
    RequestedTheme="Dark"
    Background="{ThemeResource KBackgroundBrush}">

    <!--
      外壳：标题栏 + 侧栏（MetroSidebarStyle）+ 内容 Frame + 播放器层 + 登录覆盖层。
      播放器层覆盖标题栏以下的整个窗口（含侧栏）。窄窗底部导航后续加入。
    -->
    <Grid Background="{ThemeResource KBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="16,0"
            VerticalAlignment="Center"
            FontSize="13"
            Foreground="{ThemeResource KOnBackgroundBrush}"
            Text="Ncrust" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="Sidebar"
                Grid.Column="0"
                SelectionChanged="SidebarSelectionChanged"
                Style="{StaticResource MetroSidebarStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Frame x:Name="ContentFrame" Grid.Column="1" />
        </Grid>

        <player:PlayerHost x:Name="Player" Grid.Row="1" />

        <Grid x:Name="OverlayHost" Grid.RowSpan="2" />
    </Grid>
</Page>
