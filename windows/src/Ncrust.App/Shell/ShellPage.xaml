<Page
    x:Class="Ncrust.Shell.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="{ThemeResource KBackgroundBrush}">

    <!--
      外壳占位。按 windows/AGENTS.md「UI 与交互」，这里将是：
      MetroSidebar（宽窗口）/ MetroBottomNav（窄窗口）+ 内容 Frame + 播放栏 + 全屏播放器层。
      OverlayHost 承载登录层等临时覆盖层。背景显式使用 KBackgroundBrush，不依赖系统材质。
    -->
    <Grid>
        <Grid Padding="24,32,24,0">
            <StackPanel Spacing="16" VerticalAlignment="Top">
                <TextBlock Text="Ncrust" Style="{StaticResource PageHeadingTextStyle}" />
                <Button x:Name="LoginButton" Content="登录" HorizontalAlignment="Left" Click="LoginClick" />
            </StackPanel>
        </Grid>

        <Grid x:Name="OverlayHost" />
    </Grid>
</Page>
