<UserControl
    x:Class="Ncrust.Pages.DetailHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      详情页页头（专辑 / 歌单 / 歌手共用；对应 Android DetailHeader）。参考 Apple Music / Groove 的专辑页：
      左边方形封面（直角），右边类型、大标题、副标题（可点：专辑页的歌手）、信息行，
      下面一排操作：全部播放（替换队列）/ 插播 / 最后播放，页面可在后面追加自己的按钮（收藏专辑等）。
      Android 的「全部播放」弹对话框选「现在播放 / 插播」；桌面上直接摆成按钮，少一次点击。
    -->
    <Grid x:Name="Root" ColumnSpacing="24">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Cover.Width" Value="112" />
                        <Setter Target="Cover.Height" Value="112" />
                        <Setter Target="Root.ColumnSpacing" Value="16" />
                        <Setter Target="TitleText.Style" Value="{StaticResource TitleTextStyle}" />
                        <Setter Target="AppendButton.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            x:Name="Cover"
            Width="200"
            Height="200"
            VerticalAlignment="Top"
            Background="{ThemeResource KSurfaceBrush}">
            <Image x:Name="CoverImage" Stretch="UniformToFill" />
        </Grid>

        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Bottom"
            Spacing="4">
            <TextBlock x:Name="KindText" Style="{StaticResource CaptionTextStyle}" />
            <TextBlock
                x:Name="TitleText"
                MaxLines="2"
                Style="{StaticResource PageHeadingTextStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
            <HyperlinkButton
                x:Name="SubtitleLink"
                Padding="0"
                Click="SubtitleClick"
                Visibility="Collapsed">
                <TextBlock x:Name="SubtitleLinkText" Style="{StaticResource BodyLargeTextStyle}" Foreground="{ThemeResource SystemControlForegroundAccentBrush}" />
            </HyperlinkButton>
            <TextBlock
                x:Name="SubtitleText"
                Style="{StaticResource BodyLargeTextStyle}"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="InfoText"
                Style="{StaticResource CaptionTextStyle}"
                TextWrapping="Wrap" />

            <StackPanel
                x:Name="Actions"
                Margin="0,12,0,0"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="PlayAllButton"
                    Click="PlayAllClick"
                    IsEnabled="False"
                    Style="{StaticResource MetroButtonStyle}"
                    ToolTipService.ToolTip="清空当前队列并开始播放">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE768;" />
                        <TextBlock Text="全部播放" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="InsertNextButton"
                    Click="InsertNextClick"
                    Content="插播"
                    IsEnabled="False"
                    Style="{StaticResource MetroSecondaryButtonStyle}"
                    ToolTipService.ToolTip="在当前曲目之后立即播放" />
                <Button
                    x:Name="AppendButton"
                    Click="AppendClick"
                    Content="最后播放"
                    IsEnabled="False"
                    Style="{StaticResource MetroSecondaryButtonStyle}"
                    ToolTipService.ToolTip="加到播放队列末尾" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
