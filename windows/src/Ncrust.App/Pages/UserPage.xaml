<Page
    x:Class="Ncrust.Pages.UserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="{ThemeResource KBackgroundBrush}">
    <StackPanel Padding="24,16" Spacing="12">
        <TextBlock Style="{StaticResource PageHeadingTextStyle}" Text="我的" />
        <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextStyle}" Text="未登录" />
        <Button Content="登录" Style="{StaticResource MetroButtonStyle}" Click="LoginClick" HorizontalAlignment="Left" />
    </StackPanel>
</Page>
