<Page
    x:Class="Ncrust.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kanesumi.Xaml.Controls"
    NavigationCacheMode="Enabled"
    Background="{ThemeResource KBackgroundBrush}">

    <!--
      搜索结果页。查询词来自面板顶部的搜索框（提交后导航到这里，参数是查询词）。
      三类结果用平台原生 Pivot 切换（Groove Music「我的音乐」的歌曲 / 歌手 / 专辑就是 Pivot），
      选中下划线跟随系统强调色；键盘左右、触屏滑动都由平台处理。
      NavigationCacheMode=Enabled：从后续页面返回时保留结果与所在 Tab。
    -->
    <Grid Padding="12,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12,0,24,0">
            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="搜索" />
            <TextBlock x:Name="QueryText" Style="{StaticResource PageHeadingTextStyle}" />
        </StackPanel>

        <Pivot
            x:Name="Tabs"
            Grid.Row="1"
            SelectionChanged="TabSelectionChanged">
            <PivotItem Header="歌曲">
                <ListView
                    x:Name="SongList"
                    Padding="0,0,0,24"
                    IsItemClickEnabled="True"
                    ItemClick="SongItemClick"
                    ItemContainerStyle="{StaticResource MetroListRowStyle}"
                    ItemTemplate="{StaticResource SongRowTemplate}"
                    SelectionMode="None" />
            </PivotItem>
            <PivotItem Header="专辑">
                <GridView
                    x:Name="AlbumGrid"
                    Padding="0,0,12,24"
                    IsItemClickEnabled="True"
                    ItemClick="AlbumItemClick"
                    ItemContainerStyle="{StaticResource MetroGridTileStyle}"
                    ItemTemplate="{StaticResource AlbumTileTemplate}"
                    SelectionMode="None" />
            </PivotItem>
            <PivotItem Header="歌手">
                <ListView
                    x:Name="ArtistList"
                    Padding="0,0,0,24"
                    IsItemClickEnabled="True"
                    ItemClick="ArtistItemClick"
                    ItemContainerStyle="{StaticResource MetroListRowStyle}"
                    ItemTemplate="{StaticResource ArtistRowTemplate}"
                    SelectionMode="None" />
            </PivotItem>
        </Pivot>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="1"
            Margin="24,72,24,0"
            VerticalAlignment="Top"
            Style="{StaticResource CaptionTextStyle}"
            Text="没有找到相关结果"
            Visibility="Collapsed" />

        <controls:MetroProgressRing
            x:Name="LoadingRing"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed" />
    </Grid>
</Page>
