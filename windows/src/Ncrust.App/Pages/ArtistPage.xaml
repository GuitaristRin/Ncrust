<Page
    x:Class="Ncrust.Pages.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kanesumi.Xaml.Controls"
    xmlns:local="using:Ncrust.Pages"
    Background="{ThemeResource KBackgroundBrush}">

    <!--
      歌手详情（对应 Android ArtistDetailScreen）：页头 + 原生 Pivot（专辑 / 单曲）。
      专辑来自 /api/artist/albums（进 ContentCache）；单曲是按歌手名搜索后筛出本人的歌（与 Android 相同，不进缓存）。
      页头的「全部播放 / 插播 / 最后播放」作用于单曲列表。
    -->
    <Grid Padding="24,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:DetailHeader x:Name="Header" Margin="0,0,24,8" />

        <Pivot x:Name="Tabs" Grid.Row="1" Margin="-12,0,0,0">
            <PivotItem Header="专辑">
                <GridView
                    x:Name="AlbumGrid"
                    Padding="0,0,12,24"
                    IsItemClickEnabled="True"
                    ItemClick="AlbumItemClick"
                    ItemContainerStyle="{StaticResource MetroGridTileStyle}"
                    ItemTemplate="{StaticResource ArtistAlbumTileTemplate}"
                    SelectionMode="None" />
            </PivotItem>
            <PivotItem Header="单曲">
                <ListView
                    x:Name="SongList"
                    Padding="0,0,12,24"
                    IsItemClickEnabled="True"
                    ItemClick="SongItemClick"
                    ItemContainerStyle="{StaticResource MetroListRowStyle}"
                    ItemTemplate="{StaticResource SongRowTemplate}"
                    SelectionMode="None" />
            </PivotItem>
        </Pivot>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="1"
            Margin="0,72,24,0"
            VerticalAlignment="Top"
            Style="{StaticResource CaptionTextStyle}"
            Visibility="Collapsed" />

        <controls:MetroProgressRing
            x:Name="LoadingRing"
            Grid.RowSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed" />

        <StackPanel
            x:Name="ErrorPanel"
            Grid.RowSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Style="{StaticResource CaptionTextStyle}" TextAlignment="Center" TextWrapping="Wrap" />
            <Button HorizontalAlignment="Center" Click="RetryClick" Content="重试" />
        </StackPanel>
    </Grid>
</Page>
