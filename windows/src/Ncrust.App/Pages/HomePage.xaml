<Page
    x:Class="Ncrust.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kanesumi.Xaml.Controls"
    NavigationCacheMode="Enabled"
    Background="{ThemeResource KBackgroundBrush}">

    <!--
      首页（参考 Apple Music「现在就听」）：34px 页头；未登录时顶部是登录提示而不是空的「每日推荐」；
      每个分区为空时整个分区隐藏；每日推荐带「全部播放」。
      NavigationCacheMode=Enabled：切到别的页面再回来不重新构建、不重新请求（后台刷新仍按缓存模式）。
    -->
    <Grid>
        <ScrollViewer>
            <StackPanel Padding="24,16,24,24" Spacing="16">
                <TextBlock Style="{StaticResource PageHeadingTextStyle}" Text="首页" />

                <!-- 未登录提示 -->
                <Grid
                    x:Name="LoginPrompt"
                    Padding="20"
                    Background="{ThemeResource KSurfaceBrush}"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock Style="{StaticResource TitleTextStyle}" Text="登录网易云音乐" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="登录后可以看到每日推荐，并同步你喜欢的音乐与收藏。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Click="LoginClick"
                        Content="登录"
                        Style="{StaticResource MetroButtonStyle}" />
                </Grid>

                <!-- 每日推荐 -->
                <StackPanel x:Name="DailySection" Spacing="8" Visibility="Collapsed">
                    <Grid>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" Text="每日推荐" />
                        <Button
                            HorizontalAlignment="Right"
                            Click="PlayDailyClick"
                            Style="{StaticResource MetroSecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE768;" />
                                <TextBlock Text="全部播放" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ListView
                        x:Name="DailyList"
                        IsItemClickEnabled="True"
                        ItemClick="SongItemClick"
                        ItemContainerStyle="{StaticResource MetroListRowStyle}"
                        ItemTemplate="{StaticResource SongRowTemplate}"
                        SelectionMode="None" />
                </StackPanel>

                <!-- 推荐歌单；登录后首位是私人 FM 电台卡（对应 Android 常驻首位的 FmRadioTile）。 -->
                <StackPanel x:Name="PlaylistSection" Spacing="8" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource TitleTextStyle}" Text="推荐歌单" />
                    <Button
                        x:Name="FmCard"
                        Padding="0"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Stretch"
                        Click="FmClick"
                        Style="{StaticResource MetroGhostButtonStyle}"
                        ToolTipService.ToolTip="私人 FM：无限播放为你推荐的歌曲"
                        Visibility="Collapsed">
                        <Grid
                            Width="328"
                            Height="72"
                            Background="{ThemeResource KSurfaceBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Background="{ThemeResource KPrimaryBrush}">
                                <FontIcon
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="28"
                                    Foreground="{ThemeResource KOnPrimaryBrush}"
                                    Glyph="&#xE8D6;" />
                            </Grid>
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0"
                                VerticalAlignment="Center">
                                <TextBlock x:Name="FmTitle" Style="{StaticResource BodyTextStyle}" Text="私人 FM" />
                                <TextBlock x:Name="FmSubtitle" Style="{StaticResource CaptionTextStyle}" Text="无限播放" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <GridView
                        x:Name="PlaylistGrid"
                        IsItemClickEnabled="True"
                        ItemClick="PlaylistItemClick"
                        ItemContainerStyle="{StaticResource MetroGridTileStyle}"
                        ItemTemplate="{StaticResource PlaylistTileTemplate}"
                        SelectionMode="None">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid MaximumRowsOrColumns="0" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                </StackPanel>

                <!-- 新歌速递 -->
                <StackPanel x:Name="NewSection" Spacing="8" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource TitleTextStyle}" Text="新歌速递" />
                    <ListView
                        x:Name="NewList"
                        IsItemClickEnabled="True"
                        ItemClick="SongItemClick"
                        ItemContainerStyle="{StaticResource MetroListRowStyle}"
                        ItemTemplate="{StaticResource SongRowTemplate}"
                        SelectionMode="None" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <controls:MetroProgressRing
            x:Name="LoadingRing"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed" />
    </Grid>
</Page>
