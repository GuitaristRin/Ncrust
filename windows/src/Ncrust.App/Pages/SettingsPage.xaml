<Page
    x:Class="Ncrust.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required"
    Background="{ThemeResource KBackgroundBrush}">

    <!--
      设置（对应 Android UserScreen 的「我的」页：资料 + 设置）。版式参考 Groove Music 设置页：
      左对齐单列、分组标题、限宽 720；控件一律用平台原生（ComboBox / ToggleSwitch / RadioButton / ContentDialog）。
      Android 独有的「后台运行（电池白名单）」不移植；「显示语言」等 i18n（M3）落地后再加。
      NavigationCacheMode=Required：从均衡器子页返回时保留滚动位置。
    -->
    <ScrollViewer>
        <StackPanel
            MaxWidth="720"
            Padding="24,16,24,32"
            HorizontalAlignment="Left"
            Spacing="8">
            <TextBlock Style="{StaticResource PageHeadingTextStyle}" Text="设置" />

            <!-- 账户 -->
            <TextBlock Margin="0,16,0,0" Style="{StaticResource TitleTextStyle}" Text="账户" />
            <Grid x:Name="AccountLoggedIn" ColumnSpacing="16" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image
                    x:Name="AvatarImage"
                    Width="64"
                    Height="64"
                    Stretch="UniformToFill" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="NicknameText" Style="{StaticResource TitleTextStyle}" />
                    <TextBlock x:Name="UidText" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Click="LogoutClick"
                    Content="退出登录" />
            </Grid>
            <Grid x:Name="AccountLoggedOut" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="未登录" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="登录后可以同步喜欢的音乐、收藏与每日推荐。" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="LoginClick"
                    Content="登录"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <!-- 音质偏好 -->
            <TextBlock Margin="0,24,0,0" Style="{StaticResource TitleTextStyle}" Text="音质偏好" />
            <TextBlock
                Style="{StaticResource CaptionTextStyle}"
                Text="取不到所选音质时会自动逐级降低。Windows 按网络是否「按流量计费」区分两档（对应手机端的 WLAN / 移动数据）。"
                TextWrapping="Wrap"
                TextTrimming="None" />
            <ComboBox
                x:Name="WifiQualityBox"
                MinWidth="240"
                Header="不计费网络（Wi-Fi、有线）"
                SelectionChanged="WifiQualityChanged" />
            <ComboBox
                x:Name="MeteredQualityBox"
                MinWidth="240"
                Margin="0,8,0,0"
                Header="按流量计费的网络"
                SelectionChanged="MeteredQualityChanged" />

            <!-- 播放 -->
            <TextBlock Margin="0,24,0,0" Style="{StaticResource TitleTextStyle}" Text="播放" />
            <ToggleSwitch
                x:Name="GaplessSwitch"
                Header="无缝播放"
                Toggled="GaplessToggled" />
            <TextBlock
                Margin="0,-4,0,0"
                Style="{StaticResource CaptionTextStyle}"
                Text="提前加载下一首，消除曲间空白" />
            <ToggleSwitch
                x:Name="TranslationSwitch"
                Margin="0,8,0,0"
                Header="歌词翻译"
                Toggled="TranslationToggled" />

            <!-- 音效 -->
            <TextBlock Margin="0,24,0,0" Style="{StaticResource TitleTextStyle}" Text="音效" />
            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Click="EqualizerClick">
                <Grid>
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyTextStyle}" Text="均衡器" />
                        <TextBlock x:Name="EqualizerSummary" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <FontIcon
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Glyph="&#xE76C;" />
                </Grid>
            </Button>

            <!-- 外观 -->
            <TextBlock Margin="0,24,0,0" Style="{StaticResource TitleTextStyle}" Text="外观" />
            <TextBlock Style="{StaticResource BodyTextStyle}" Text="主题模式" />
            <StackPanel>
                <RadioButton
                    x:Name="ThemeSystemRadio"
                    Checked="ThemeChecked"
                    Content="跟随系统"
                    GroupName="Theme"
                    Tag="System" />
                <RadioButton
                    x:Name="ThemeDarkRadio"
                    Checked="ThemeChecked"
                    Content="深色"
                    GroupName="Theme"
                    Tag="Dark" />
                <RadioButton
                    x:Name="ThemeLightRadio"
                    Checked="ThemeChecked"
                    Content="浅色"
                    GroupName="Theme"
                    Tag="Light" />
            </StackPanel>
            <TextBlock Margin="0,12,0,0" Style="{StaticResource BodyTextStyle}" Text="强调色" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Rectangle
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource KPrimaryBrush}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextStyle}"
                    Text="跟随 Windows 的强调色" />
                <HyperlinkButton
                    VerticalAlignment="Center"
                    Click="OpenColorSettingsClick"
                    Content="更改 Windows 颜色设置" />
            </StackPanel>

            <!-- 存储与缓存 -->
            <TextBlock Margin="0,24,0,0" Style="{StaticResource TitleTextStyle}" Text="存储与缓存" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="CacheSizeText"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextStyle}"
                    Text="缓存占用 计算中…" />
                <Button
                    x:Name="ClearCacheButton"
                    Grid.Column="1"
                    Click="ClearCacheClick"
                    Content="清除缓存" />
            </Grid>
            <TextBlock
                Style="{StaticResource CaptionTextStyle}"
                Text="包括图片、歌词与页面缓存；不会清除登录状态、音乐库与播放队列。"
                TextWrapping="Wrap"
                TextTrimming="None" />

            <!-- 关于 -->
            <TextBlock Margin="0,24,0,0" Style="{StaticResource TitleTextStyle}" Text="关于" />
            <TextBlock x:Name="VersionText" Style="{StaticResource BodyTextStyle}" />
            <TextBlock
                Style="{StaticResource CaptionTextStyle}"
                Text="网易云音乐第三方客户端。仅供学习交流使用，请支持正版音乐。"
                TextWrapping="Wrap"
                TextTrimming="None" />
            <HyperlinkButton Content="GitHub · GuitaristRin/Ncrust" NavigateUri="https://github.com/GuitaristRin/Ncrust" />
        </StackPanel>
    </ScrollViewer>
</Page>
