<UserControl
    x:Class="Ncrust.Player.PlayerHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:kc="using:Kanesumi.Xaml.Controls">

    <!--
      播放器层（对应 Android PlayerCardOverlay + PlayerCard）：常驻覆盖层，两个标量驱动全部形变 ——
      Progress（0 迷你栏 → 1 展开卡片）、Fullscreen（0 卡片 → 1 真全屏），都在 CompositionPropertySet 里。

      - 展开：整张卡片从底部上滑（Translation.Y = (H - 72) × (1 - Progress)），迷你栏随动上移并淡出
        （与 Android 卡片整体上滑、迷你栏在卡片顶部淡出一致）。
      - 卡片有自己的一套信息与控件（大标题、歌手 / 专辑、进度条、播放按钮、收藏、音量），不沿用迷你栏。
      - 卡片里没有「只有封面」的状态：宽窗口左栏封面 + 信息 + 控件、右栏歌词 / 队列；窄窗口顶部小封面，
        中间歌词 / 队列，底部控件。只有真全屏才是封面铺满。
      - 封面仍是全应用唯一的元素：从迷你栏缩略图形变到卡片的封面位（CoverSlot）再到全屏。

      命中测试不认 Composition 变换，所以两个会动的层都按「静止时的位置」布局：迷你栏布局在底部
      （上移只是视觉），卡片布局铺满（下移只是视觉），收起时卡片关掉命中测试。
      Root 不设背景（null）：空白处点击穿透到下面的页面。
    -->
    <Grid x:Name="Root" Background="{x:Null}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <!-- 宽窗口：Groove 式传输栏；卡片左栏正在播放 + 右栏歌词 / 队列。 -->
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="600" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- 窄窗口：迷你栏退化为 Android 迷你栏；卡片改为上中下三段。 -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SeekRow.Visibility" Value="Collapsed" />
                        <Setter Target="ModeButton.Visibility" Value="Collapsed" />
                        <Setter Target="PreviousButton.Visibility" Value="Collapsed" />
                        <Setter Target="VolumeButton.Visibility" Value="Collapsed" />
                        <Setter Target="LyricsButton.Visibility" Value="Collapsed" />
                        <Setter Target="QueueButton.Visibility" Value="Collapsed" />
                        <Setter Target="SlimProgress.Visibility" Value="Visible" />
                        <Setter Target="TransportColumn.Width" Value="Auto" />

                        <Setter Target="Stage.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="Stage.VerticalAlignment" Value="Stretch" />
                        <Setter Target="Stage.Margin" Value="16,52,16,16" />
                        <Setter Target="Stage.ColumnSpacing" Value="0" />
                        <Setter Target="StageRow1.Height" Value="*" />
                        <Setter Target="InfoPanel.Orientation" Value="Horizontal" />
                        <Setter Target="InfoText.Margin" Value="12,0,0,0" />
                        <Setter Target="InfoText.VerticalAlignment" Value="Center" />
                        <Setter Target="SideTabs.(Grid.Row)" Value="1" />
                        <Setter Target="SideTabs.(Grid.RowSpan)" Value="1" />
                        <Setter Target="SideTabs.(Grid.Column)" Value="0" />
                        <Setter Target="SideTabs.Margin" Value="-12,8,0,8" />
                        <Setter Target="SideTabs.VerticalAlignment" Value="Stretch" />
                        <Setter Target="ControlsPanel.(Grid.Row)" Value="2" />
                        <Setter Target="ControlsPanel.Margin" Value="0" />
                        <Setter Target="VolumeRow.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--
          ── 展开卡片：铺满布局，收起时由合成平移到只剩顶边 72（被迷你栏盖住） ──

          构图（参考 Apple Music / Groove 的「正在播放」）：左右两栏作为一个整体在卡片里居中。
          左栏以封面宽度为一条竖轴：封面、标题 / 歌手 / 专辑、进度条（时间在两端下方）、
          传输行（模式与收藏在两端，上一首 / 播放 / 下一首居中）、音量，全部与封面左右对齐。
          右栏歌词 / 队列与左栏等高、上沿与封面上沿对齐。尺寸在代码里按窗口计算（ApplyCardLayout）。
        -->
        <Grid
            x:Name="Card"
            Background="{ThemeResource KBackgroundBrush}"
            IsHitTestVisible="False">
            <Grid x:Name="CardContent">
                <Button
                    Margin="8,4,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Click="CollapseClick"
                    Style="{StaticResource MetroIconButtonStyle}"
                    ToolTipService.ToolTip="收起 (Esc)">
                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE70D;" />
                </Button>

                <Grid
                    x:Name="Stage"
                    Margin="0,48,0,32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ColumnSpacing="64">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="StageRow0" Height="Auto" />
                        <RowDefinition x:Name="StageRow1" Height="Auto" />
                        <RowDefinition x:Name="StageRow2" Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColumn" Width="320" />
                        <ColumnDefinition x:Name="RightColumn" Width="480" />
                    </Grid.ColumnDefinitions>

                    <!-- 正在播放：封面位 + 标题 / 歌手 / 专辑。封面本身是层外那张唯一的 CoverImage，这里只占位。 -->
                    <StackPanel x:Name="InfoPanel" VerticalAlignment="Top">
                        <Border
                            x:Name="CoverSlot"
                            Width="320"
                            Height="320"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top" />
                        <StackPanel x:Name="InfoText" Margin="0,24,0,0">
                            <TextBlock
                                x:Name="CardTitle"
                                FontSize="20"
                                FontWeight="SemiBold"
                                LineHeight="26"
                                MaxLines="1"
                                Style="{StaticResource TitleLargeTextStyle}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <HyperlinkButton
                                x:Name="CardArtistLink"
                                Margin="0,4,0,0"
                                Padding="0"
                                Click="CardArtistClick"
                                ToolTipService.ToolTip="转到歌手">
                                <TextBlock
                                    x:Name="CardArtist"
                                    Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                                    Style="{StaticResource BodyTextStyle}"
                                    TextTrimming="CharacterEllipsis" />
                            </HyperlinkButton>
                            <HyperlinkButton
                                x:Name="CardAlbumLink"
                                Padding="0"
                                Click="CardAlbumClick"
                                ToolTipService.ToolTip="转到专辑">
                                <TextBlock
                                    x:Name="CardAlbum"
                                    Foreground="{ThemeResource KOnSurfaceVariantBrush}"
                                    Style="{StaticResource CaptionTextStyle}"
                                    TextTrimming="CharacterEllipsis" />
                            </HyperlinkButton>
                        </StackPanel>
                    </StackPanel>

                    <!-- 卡片自己的控件（对应 Android FullPlayerControls），与封面同宽。 -->
                    <StackPanel
                        x:Name="ControlsPanel"
                        Grid.Row="1"
                        Margin="0,16,0,0"
                        VerticalAlignment="Top">
                        <Slider
                            x:Name="CardSeekSlider"
                            VerticalAlignment="Center"
                            IsThumbToolTipEnabled="False"
                            Maximum="1"
                            Minimum="0"
                            StepFrequency="1"
                            ValueChanged="SeekValueChanged" />
                        <Grid Margin="0,-6,0,0">
                            <TextBlock
                                x:Name="CardPositionText"
                                Foreground="{ThemeResource KOnSurfaceVariantBrush}"
                                Style="{StaticResource LabelTextStyle}"
                                Text="0:00" />
                            <TextBlock
                                x:Name="CardDurationText"
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource KOnSurfaceVariantBrush}"
                                Style="{StaticResource LabelTextStyle}"
                                Text="0:00" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Button
                                x:Name="CardModeButton"
                                Width="40"
                                Height="40"
                                Margin="-8,0,0,0"
                                HorizontalAlignment="Left"
                                Click="ModeClick"
                                Style="{StaticResource MetroIconButtonStyle}">
                                <FontIcon x:Name="CardModeIcon" FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE8EE;" />
                            </Button>
                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="12">
                                <Button
                                    Width="48"
                                    Height="48"
                                    Click="PreviousClick"
                                    Style="{StaticResource MetroIconButtonStyle}"
                                    ToolTipService.ToolTip="上一首 (Ctrl+←)">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="20" Glyph="&#xE892;" />
                                </Button>
                                <Button
                                    Width="56"
                                    Height="56"
                                    Click="PlayPauseClick"
                                    Style="{StaticResource MetroIconButtonStyle}"
                                    ToolTipService.ToolTip="播放 / 暂停 (Space)">
                                    <FontIcon x:Name="CardPlayIcon" FontFamily="Segoe MDL2 Assets" FontSize="30" Glyph="&#xE768;" />
                                </Button>
                                <Button
                                    Width="48"
                                    Height="48"
                                    Click="NextClick"
                                    Style="{StaticResource MetroIconButtonStyle}"
                                    ToolTipService.ToolTip="下一首 (Ctrl+→)">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="20" Glyph="&#xE893;" />
                                </Button>
                            </StackPanel>
                            <Button
                                x:Name="LikeButton"
                                Width="40"
                                Height="40"
                                Margin="0,0,-8,0"
                                HorizontalAlignment="Right"
                                Click="LikeClick"
                                Style="{StaticResource MetroIconButtonStyle}"
                                ToolTipService.ToolTip="加入库">
                                <FontIcon x:Name="LikeIcon" FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xEB51;" />
                            </Button>
                        </Grid>

                        <Grid x:Name="VolumeRow" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Width="32"
                                Height="32"
                                Margin="-6,0,4,0"
                                Click="MuteClick"
                                Style="{StaticResource MetroIconButtonStyle}"
                                ToolTipService.ToolTip="静音">
                                <FontIcon x:Name="CardVolumeIcon" FontFamily="Segoe MDL2 Assets" FontSize="13" Glyph="&#xE767;" />
                            </Button>
                            <Slider
                                x:Name="CardVolumeSlider"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Maximum="100"
                                Minimum="0"
                                ValueChanged="VolumeValueChanged" />
                        </Grid>
                    </StackPanel>

                    <!-- 歌词 / 播放队列（对应 Android LyricsView / QueueView）：与左栏等高（高度在代码里跟随左栏）。 -->
                    <Pivot
                        x:Name="SideTabs"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Margin="-12,-8,0,0"
                        VerticalAlignment="Top"
                        SelectionChanged="SideTabsChanged">
                        <!-- 页签默认 24，比歌名还大、压过左栏：降到 18。 -->
                        <Pivot.Resources>
                            <x:Double x:Key="PivotHeaderItemFontSize">18</x:Double>
                        </Pivot.Resources>
                        <PivotItem Header="歌词">
                            <Grid>
                                <kc:MetroLyricsPanel x:Name="Lyrics" />
                                <TextBlock
                                    x:Name="LyricsStatus"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource KOnSurfaceVariantBrush}"
                                    Style="{StaticResource BodyLargeTextStyle}"
                                    Text="暂无歌词"
                                    Visibility="Collapsed" />
                            </Grid>
                        </PivotItem>
                        <PivotItem Header="播放队列">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Button
                                    HorizontalAlignment="Right"
                                    Click="ClearQueueClick"
                                    Content="清空播放内容"
                                    Style="{StaticResource MetroGhostButtonStyle}" />
                                <ListView
                                    x:Name="QueueList"
                                    Grid.Row="1"
                                    AllowDrop="True"
                                    CanDragItems="True"
                                    CanReorderItems="True"
                                    IsItemClickEnabled="True"
                                    ItemContainerStyle="{StaticResource MetroListRowStyle}"
                                    ItemTemplateSelector="{StaticResource QueueRowTemplateSelector}"
                                    SelectionMode="None" />
                                <TextBlock
                                    x:Name="QueueEmpty"
                                    Grid.Row="1"
                                    Margin="0,24,0,0"
                                    Style="{StaticResource CaptionTextStyle}"
                                    Text="播放队列为空"
                                    Visibility="Collapsed" />
                            </Grid>
                        </PivotItem>
                    </Pivot>
                </Grid>
            </Grid>
        </Grid>

        <!-- ── 迷你栏 / 传输栏（高 72）：布局在底部，展开时由合成随卡片上移并淡出 ── -->
        <Grid
            x:Name="MiniBar"
            Height="72"
            VerticalAlignment="Bottom"
            Background="{ThemeResource KSurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" MinWidth="96" MaxWidth="320" />
                <ColumnDefinition x:Name="TransportColumn" Width="2*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
              封面的点击区：唯一封面元素按全屏尺寸布局、靠 Composition 缩小显示，而 XAML 命中测试
              不认 Composition 变换 —— 让封面本身接收点击会挡住一大片界面，所以点击放在这里。
            -->
            <Grid
                Grid.Column="0"
                Background="Transparent"
                Tapped="CoverTapped" />

            <!-- 顶边细进度条：只在窄窗口显示（对应 Android SlimProgressBar）。 -->
            <ProgressBar
                x:Name="SlimProgress"
                Grid.ColumnSpan="4"
                Height="2"
                MinHeight="2"
                VerticalAlignment="Top"
                Maximum="1"
                Minimum="0"
                Visibility="Collapsed" />

            <!-- 曲目信息：点击展开卡片（Groove：点正在播放的信息进入「正在播放」）。 -->
            <Grid
                Grid.Column="1"
                Padding="12,0"
                Background="Transparent"
                Tapped="InfoTapped">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="MiniTitle"
                        Style="{StaticResource BodyTextStyle}"
                        Text="未在播放"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="MiniArtist"
                        Style="{StaticResource CaptionTextStyle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Grid
                x:Name="TransportPanel"
                Grid.Column="2"
                VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="ModeButton"
                        Width="36"
                        Height="36"
                        Click="ModeClick"
                        Style="{StaticResource MetroIconButtonStyle}">
                        <FontIcon x:Name="ModeIcon" FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE8EE;" />
                    </Button>
                    <Button
                        x:Name="PreviousButton"
                        Width="36"
                        Height="36"
                        Click="PreviousClick"
                        Style="{StaticResource MetroIconButtonStyle}"
                        ToolTipService.ToolTip="上一首 (Ctrl+←)">
                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE892;" />
                    </Button>
                    <Button
                        x:Name="PlayButton"
                        Width="40"
                        Height="36"
                        Click="PlayPauseClick"
                        Style="{StaticResource MetroIconButtonStyle}"
                        ToolTipService.ToolTip="播放 / 暂停 (Space)">
                        <FontIcon x:Name="MiniPlayIcon" FontFamily="Segoe MDL2 Assets" FontSize="18" Glyph="&#xE768;" />
                    </Button>
                    <Button
                        x:Name="NextButton"
                        Width="36"
                        Height="36"
                        Click="NextClick"
                        Style="{StaticResource MetroIconButtonStyle}"
                        ToolTipService.ToolTip="下一首 (Ctrl+→)">
                        <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="14" Glyph="&#xE893;" />
                    </Button>
                </StackPanel>

                <Grid
                    x:Name="SeekRow"
                    Grid.Row="1"
                    MaxWidth="560"
                    Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="PositionText"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource KOnSurfaceVariantBrush}"
                        Style="{StaticResource LabelTextStyle}"
                        Text="0:00"
                        TextAlignment="Right" />
                    <Slider
                        x:Name="SeekSlider"
                        Grid.Column="1"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        IsThumbToolTipEnabled="False"
                        Maximum="1"
                        Minimum="0"
                        StepFrequency="1"
                        ValueChanged="SeekValueChanged" />
                    <TextBlock
                        x:Name="DurationText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource KOnSurfaceVariantBrush}"
                        Style="{StaticResource LabelTextStyle}"
                        Text="0:00" />
                </Grid>
            </Grid>

            <StackPanel
                Grid.Column="3"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    x:Name="VolumeButton"
                    Width="40"
                    Height="40"
                    Style="{StaticResource MetroIconButtonStyle}"
                    ToolTipService.ToolTip="音量">
                    <FontIcon x:Name="VolumeIcon" FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE767;" />
                    <Button.Flyout>
                        <Flyout Placement="Top">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Width="40"
                                    Height="40"
                                    Click="MuteClick"
                                    Style="{StaticResource MetroIconButtonStyle}"
                                    ToolTipService.ToolTip="静音">
                                    <FontIcon x:Name="MuteIcon" FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE767;" />
                                </Button>
                                <Slider
                                    x:Name="VolumeSlider"
                                    Width="160"
                                    VerticalAlignment="Center"
                                    Maximum="100"
                                    Minimum="0"
                                    ValueChanged="VolumeValueChanged" />
                                <TextBlock
                                    x:Name="VolumeText"
                                    Width="28"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="LyricsButton"
                    Width="40"
                    Height="40"
                    Click="LyricsClick"
                    Style="{StaticResource MetroIconButtonStyle}"
                    ToolTipService.ToolTip="歌词 (Ctrl+L)">
                    <TextBlock FontSize="15" Text="词" />
                </Button>
                <Button
                    x:Name="QueueButton"
                    Width="40"
                    Height="40"
                    Click="QueueClick"
                    Style="{StaticResource MetroIconButtonStyle}"
                    ToolTipService.ToolTip="播放队列">
                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE8FD;" />
                </Button>
                <Button
                    x:Name="ExpandButton"
                    Width="40"
                    Height="40"
                    Click="ExpandClick"
                    Style="{StaticResource MetroIconButtonStyle}"
                    ToolTipService.ToolTip="正在播放">
                    <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE70E;" />
                </Button>
            </StackPanel>
        </Grid>

        <!--
          封面预加载器：BitmapImage 只有挂在可视树里的 Image 上才会开始下载解码。新封面先挂到这里，
          ImageOpened 后再换到唯一封面上 —— 换歌期间旧封面保留，不露空。
        -->
        <Image
            x:Name="CoverPreloader"
            Width="1"
            Height="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Opacity="0" />

        <!--
          唯一封面：对齐到 Root 左下，布局尺寸 = 真全屏尺寸（代码里随窗口设置），由 Composition
          缩小到卡片封面位 / 迷你栏缩略图。按最大尺寸布局再缩小，封面在任何状态下都清晰。
          不接收点击，点击区在迷你栏第 0 列。
        -->
        <Image
            x:Name="CoverImage"
            Width="72"
            Height="72"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            Stretch="UniformToFill" />

        <!-- 真全屏的操作层：双击任意处或右上角按钮退出；只在全屏时接收点击。 -->
        <Grid
            x:Name="FullscreenLayer"
            Background="Transparent"
            DoubleTapped="FullscreenDoubleTapped"
            IsHitTestVisible="False">
            <Button
                Margin="0,8,8,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="FullscreenClick"
                Style="{StaticResource MetroIconButtonStyle}"
                ToolTipService.ToolTip="退出全屏 (Esc / F11)">
                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="16" Glyph="&#xE73F;" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
