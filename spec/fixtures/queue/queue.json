  {
    "id": "queue.insert-next.dedupe-before-current",
    "kind": "op",
    "description": "待插入的歌在队首（当前歌之前）时，先删重复再插，当前索引必须重新定位到当前歌。",
    "source": "app/.../MainActivity.kt insertNext",
    "input": {
      "queue": [5, 1, 3, 2],
      "current": 2,
      "mode": "CYCLE",
      "op": { "type": "insertNext", "id": 5 }
    },
    "expect": { "queue": [1, 3, 5, 2], "current": 1 }
  },
  {
