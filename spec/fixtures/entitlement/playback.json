      "sessionValid": false,
      "item": {
        "id": 347230,
        "url": "http://m702.music.126.net/x.mp3",
        "code": 200,
        "level": "standard",
        "fee": 1,
        "freeTrialInfo": {
          "fragmentType": -1,
          "start": 0,
          "end": 45,
          "algData": {
            "fragSource": "default"
          }
