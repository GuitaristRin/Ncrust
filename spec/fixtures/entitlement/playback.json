        "freeTrialPrivilege": {
          "resConsumable": true,
          "userConsumable": false,
          "listenType": null,
          "cannotListenReason": null,
          "playReason": null,
          "freeLimitTagType": null
        }
      },
      "privilege": {
        "st": 0,
        "pl": 0,
        "fee": 1
      }
    },
    "expect": {
      "kind": "trial",
      "trialSeconds": 45,
      "reason": "login"
    }
  },
