{
  "$comment": "Ncrust 设计 token。只收录已在某端代码中落地的取值；每组注明来源。尺寸单位：Android dp/sp == Windows 有效像素(epx)，1:1 换算。颜色 #AARRGGBB 或 #RRGGBB。",
  "version": 1,

  "color": {
    "$source": "app/.../ui/theme/NcrustColors.kt (DefaultNcrustColors / LightNcrustColors / toMetroColors)",
    "dark": {
      "background": "#000000",
      "surface": "#1A1A1A",
      "surfaceVariant": "#1A1A1A",
      "onBackground": "#FFFFFF",
      "onSurface": "#FFFFFF",
      "onSurfaceVariant": "#B3B3B3",
      "onPrimary": "#FFFFFF",
      "divider": "#2A2A2A",
      "pressTint": "#22FFFFFF"
    },
    "light": {
      "background": "#F6F2E9",
      "surface": "#FFFDF8",
      "surfaceVariant": "#EDE6D8",
      "onBackground": "#1C1A16",
      "onSurface": "#1C1A16",
      "onSurfaceVariant": "#6E6658",
      "onPrimary": "#FFFFFF",
      "divider": "#E2DACB",
      "pressTint": "#14000000"
    },
    "accents": {
      "$source": "app/.../ui/theme/ThemeManager.kt themeColorPresets；索引即持久化值，越界兜底 0",
      "default": 0,
      "presets": [
        { "index": 0, "id": "spruce",   "zh": "云杉", "color": "#1DB954" },
        { "index": 1, "id": "cobalt",   "zh": "钴蓝", "color": "#3B82F6" },
        { "index": 2, "id": "crimson",  "zh": "绯红", "color": "#EF4444" },
        { "index": 3, "id": "amber",    "zh": "琥珀", "color": "#F59E0B" },
        { "index": 4, "id": "violet",   "zh": "堇紫", "color": "#8B5CF6" },
        { "index": 5, "id": "plain",    "zh": "素白", "color": "#FFFFFF", "$note": "色块在深色底上需加灰色描边（ThemeColorSelector.kt）" }
      ]
    },
    "modes": ["system", "dark", "light"],
    "lyrics": {
      "$source": "Kanesumi-sec-a MetroLyricsPanel.kt 默认参数",
      "current": "primary",
      "past": "#99FFFFFF",
      "future": "#66888888"
    }
  },

  "typography": {
    "$source": "Kanesumi-sec-a kanesumi-core MetroTypography.kt；[size, lineHeight, weight]",
    "semantic": {
      "pageHeading": [34, 42, 400],
      "title":       [22, 28, 400],
      "body":        [15, 22, 400],
      "caption":     [13, 18, 400],
      "label":       [11, 14, 400]
    },
    "scale": {
      "headlineMedium": [28, 36, 400],
      "titleLarge":     [22, 28, 400],
      "titleMedium":    [16, 24, 500],
      "bodyLarge":      [16, 24, 400],
      "bodyMedium":     [14, 20, 400],
      "bodySmall":      [12, 16, 400]
    },
    "lyrics": {
      "$source": "Kanesumi-sec-a MetroLyricsPanel.kt",
      "line": [32, 42, 700],
      "translation": [20, 26, 400]
    },
    "tab": {
      "$source": "Kanesumi-sec-a MetroTabRow.kt；选中 500 / 未选中 400",
      "text": [14, null, 400]
    }
  },

  "easing": {
    "$comment": "全部可精确表示为 cubic-bezier(x1, y1, x2, y2)，Windows 直接用于 CubicBezierEasingFunction / KeySpline。",
    "standard":       { "bezier": [0.2, 0.0, 0.0, 1.0], "$note": "Android CubicBezierEasing(0.2,0,0,1)" },
    "fastOutSlowIn":  { "bezier": [0.4, 0.0, 0.2, 1.0], "$note": "Compose FastOutSlowInEasing" },
    "linearOutSlowIn":{ "bezier": [0.0, 0.0, 0.2, 1.0], "$note": "Compose LinearOutSlowInEasing" },
    "metroDefault":   { "bezier": [0.333333, 0.666667, 0.666667, 1.0], "$note": "UwpEasing Quadratic/EaseOut = 1-(1-t)^2，精确等价" },
    "metroCubic":     { "bezier": [0.333333, 1.0, 0.666667, 1.0], "$note": "UwpEasing Cubic/EaseOut = 1-(1-t)^3，精确等价；MetroIndication 的 EaseOutCubic 同此" },
    "linear":         { "bezier": [0.0, 0.0, 1.0, 1.0] }
  },

  "motion": {
    "$source": "Kanesumi-sec-a SokuouPresets/SokuouTweens 与各控件；Ncrust PlayerCard.kt。[durationMs, easing]",
    "$comment": "Ncrust 不使用弹簧。Ether 桌面扇区的时长（如 toggle 150ms）与此不同，Ncrust 各端以本表为准。",
    "sheetAppear":      [300, "standard"],
    "sheetDismiss":     [260, "fastOutSlowIn"],
    "quickSwitch":      [180, "fastOutSlowIn"],
    "coverFade":        [400, "standard"],
    "colorTransition":  [300, "metroDefault"],
    "toggleFlip":       [220, "metroCubic"],
    "indicationEnter":  [100, "metroCubic"],
    "indicationExit":   [200, "metroCubic"],
    "tabIndicator":     [200, "metroCubic"],
    "tabText":          [180, "metroCubic"],
    "navIndicator":     [200, "metroCubic"],
    "menuAppear":       [180, "metroCubic"],
    "detailEnter":      [220, "metroDefault"],
    "lyricLineSwitch":  [180, "fastOutSlowIn"],
    "lyricPanelFadeIn": [400, "standard"],
    "progressRingTurn": [1000, "linear"],
    "playerExpand":     [400, "standard"],
    "playerCollapse":   [260, "fastOutSlowIn"]
  },

  "motionParams": {
    "detailEnterOffset": 12,
    "menuAppearScaleYFrom": 0.92,
    "menuOffsetY": 8,
    "lyricScaleMin": 0.82,
    "lyricScaleDistance": 1.8,
    "lyricAnchorViewportFraction": 0.36,
    "lyricManualScrollPauseMs": 5000,
    "playerSnapThreshold": 0.25,
    "playerHeavyChildrenMinProgress": 0.05,
    "playerCoverHoldMs": 400,
    "bottomSheetDismissThreshold": 0.6,
    "bottomSheetScrimAlpha": 0.6,
    "topScrimAlpha": 0.55,
    "disabledAlpha": 0.4
  },

  "layout": {
    "$source": "Ncrust AGENTS.md / MainActivity.kt / SongCard.kt；Kanesumi-sec-a 各控件默认值",
    "wideBreakpoint": 600,
    "phoneMaxContentWidth": 360,
    "sidebarWidth": 200,
    "sidebarRowHeight": 48,
    "sidebarIndicatorWidth": 3,
    "bottomNavHeight": 56,
    "bottomNavIndicator": [24, 2],
    "miniBarHeight": 56,
    "bottomOverlayInsetNarrow": 144,
    "bottomOverlayInsetWide": 64,
    "pageHeadingSize": 34,
    "listCoverSize": 72,
    "listRowPadding": { "start": 0, "end": 16, "top": 8, "bottom": 8 },
    "listRowGap": 12,
    "gridSpacing": 2,
    "touchTarget": 48,
    "iconSize": 24,
    "navIconSize": 22,
    "tabHeight": 48,
    "tabIndicatorHeight": 2,
    "buttonPadding": [16, 12],
    "buttonIconSize": 18,
    "textFieldPadding": 12,
    "dividerThickness": 1,
    "switchSize": [52, 28],
    "switchThumbWidth": 22,
    "switchPadding": 3,
    "dialogWidth": 280,
    "menuMaxWidth": 220,
    "menuItemPadding": [16, 12],
    "selectorItemHeight": 44,
    "selectorMaxSize": [320, 400],
    "selectedBarWidth": 3,
    "progressRing": { "size": 36, "stroke": 3, "sweepDegrees": 270 },
    "topScrimHeight": 120
  }
}
